# Supabase Configuration
# Required for Supabase client-side and server-side connections.
# Obtain these values from your Supabase project dashboard (Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY)
# CRITICAL: Keep this secret. Never expose this key in client-side code,
# never prefix with NEXT_PUBLIC_, and never commit to public version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
